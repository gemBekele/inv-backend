# Test Environment Configuration
NODE_ENV=test
PORT=3001
API_PREFIX=api/v1

# Test Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=test_user
DB_PASSWORD=test_password
DB_NAME=test_inventory_db

# JWT
JWT_SECRET=test-jwt-secret-key-for-testing-only
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=test-jwt-refresh-secret-key-for-testing-only
JWT_REFRESH_EXPIRES_IN=24h

# Redis (for testing - you might want to use a separate Redis instance)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

# Admin User (for seeding tests)
ADMIN_EMAIL=admin@test.com
ADMIN_PASSWORD=testpassword123
ADMIN_FIRST_NAME=Test
ADMIN_LAST_NAME=Admin

# Logging
LOG_LEVEL=error

# Security
BCRYPT_ROUNDS=4

# Swagger
SWAGGER_TITLE=Test Inventory API
SWAGGER_DESCRIPTION=Test API for inventory management system
SWAGGER_VERSION=1.0.0
SWAGGER_TAG=test-api
